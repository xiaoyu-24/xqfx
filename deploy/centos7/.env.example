# Copy to /www/wwwroot/requirements-platform/.env and fill in real values.
DB_URL=jdbc:mysql://127.0.0.1:3306/requirements_platform?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=requirements_app
DB_PASSWORD=CHANGE_ME
ATTACHMENTS_ROOT=/www/wwwroot/requirements-platform/data/uploads
ATTACHMENTS_MINIMUM_FREE_SPACE_BYTES=1073741824
ATTACHMENTS_PREVIEW_ROOT=/www/wwwroot/requirements-platform/data/previews
LIBREOFFICE_EXECUTABLE=/usr/bin/libreoffice
ATTACHMENTS_PREVIEW_TIMEOUT_SECONDS=60
ATTACHMENTS_PREVIEW_CONCURRENCY=2
# Optional timeout for a request to the configured OpenAI-compatible provider.
AI_REQUEST_TIMEOUT_SECONDS=30
