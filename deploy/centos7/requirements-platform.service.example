[Unit]
Description=Requirements Platform Backend
After=network.target mysqld.service

[Service]
Type=simple
User=requirements
Group=requirements
WorkingDirectory=/www/wwwroot/requirements-platform/backend
EnvironmentFile=/www/wwwroot/requirements-platform/.env
ExecStart=/usr/bin/java -jar /www/wwwroot/requirements-platform/backend/requirements-platform-0.1.0-SNAPSHOT.jar --server.port=8080
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
LimitNOFILE=65535
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
